{
  "id": "main-trend",
  "page": "monitor",
  "order": 1,
  "title": "指标历史（官方序列 · 交叉验证）",
  "empty": "加载数据中…",
  "navLabel": "监控台",
  "navSub": "MONITOR · 利率走廊与政策工具",
  "pick": {
    "notSurface": [
      "strip",
      "gold",
      "cn-balance"
    ]
  },
  "views": [
    {
      "projection": "header",
      "container": "header"
    },
    {
      "projection": "tiles",
      "container": "strip",
      "pick": {
        "surface": "strip"
      },
      "ariaLabel": "政策利率走廊"
    },
    {
      "projection": "toolbar",
      "container": "toolbar",
      "granularity": true,
      "overlay": true
    },
    {
      "projection": "panel",
      "container": "chart",
      "size": "mid"
    }
  ],
  "axes": {
    "rate": {
      "unit": "%",
      "side": "left",
      "resolve": "shared"
    },
    "spread": {
      "unit": "bp",
      "side": "right",
      "resolve": "independent",
      "precision": 0
    },
    "amount": {
      "unit": " 十亿美元",
      "side": "right",
      "resolve": "independent",
      "precision": 3
    },
    "share": {
      "unit": "%",
      "side": "right",
      "label": "准备金/银行资产 %",
      "resolve": "independent",
      "precision": 1
    }
  },
  "axisBy": [
    {
      "when": {
        "unit": "%"
      },
      "axis": "rate"
    },
    {
      "when": {
        "unit": "bp"
      },
      "axis": "spread"
    },
    {
      "when": {
        "unit": " 十亿美元"
      },
      "axis": "amount"
    }
  ],
  "layers": [
    {
      "series": "primary"
    },
    {
      "series": "overlay",
      "style": {
        "width": "$chart-line-width-strong",
        "opacity": 0.82,
        "connect": true
      }
    }
  ],
  "overlay": {
    "maxShared": 2
  },
  "presets": "standard",
  "defaultPreset": "1Y",
  "annotations": [
    "zones"
  ],
  "legend": "auto",
  "tooltip": {
    "columns": [
      "value",
      "ohlc",
      "zone",
      "validation",
      "correction",
      "suspect"
    ]
  },
  "limits": {
    "sharedMax": 5,
    "totalMax": 6
  }
}
