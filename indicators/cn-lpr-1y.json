{
  "id": "cn-lpr-1y",
  "region": "cn",
  "order": 7,
  "surface": "strip",
  "name": "LPR 1Y",
  "en": "Loan Prime Rate 1Y",
  "formula": "1 年期贷款市场报价利率",
  "unit": "%",
  "hue": "hue-2",
  "publication": "M",
  "description": "1 年期 LPR（贷款市场报价利率），由全国银行间同业拆借中心（央行直属）每月 20 日公布，是当前中国贷款利率定价基准。源端限制：中国货币网 LprHis 无论是否携带日期区间都只回最近 12 期，官方 Excel 导出的数值列为空，因此本行历史长度受发布方限制，只用官方已发布的期次，绝不外推造数。交叉验证：LPR 1Y 与 Shibor 1Y 差值带宽 [1.10, 1.90]，按官方接口可得的近 12 期实测（1.35~1.56）留出政策利率调降空间。",
  "operation": "level",
  "scale": 1,
  "precision": 2,
  "start": "2024-01-01",
  "legs": [
    {
      "key": "lpr1y",
      "label": "LPR 1Y",
      "primary": {
        "provider": "cfets-lpr",
        "tenor": "1Y"
      },
      "check": {
        "provider": "series",
        "id": "cn-shibor-1y",
        "mode": "diff",
        "band": [
          1.1,
          1.9
        ],
        "source": {
          "statistic": "manual-policy",
          "window": "2025-12-22 ~ 2026-11-20",
          "measured": {
            "devLo": 1.35,
            "devHi": 1.5623,
            "checked": 12
          },
          "note": "带 [1.1, 1.9] 覆盖同窗口实测偏差 [1.35, 1.5623]；门禁每轮复算包含关系与松紧上限（12 倍）"
        }
      }
    }
  ],
  "checkKind": "跨市场逐期带宽（LPR 1Y ↔ Shibor 1Y：贷款端定价 ↔ 拆借端定价）",
  "integrity": {
    "range": [
      1.5,
      6
    ],
    "maxAbsJump": 0.5,
    "source": {
      "range": {
        "statistic": "manual-policy",
        "window": "2025-12-22 ~ 2026-11-20",
        "measured": {
          "min": 3,
          "max": 3,
          "p02": 3,
          "p998": 3,
          "n": 12
        },
        "note": "声明带 [1.5, 6] 由实测 [3, 3] 向外取整而得；外扩是有意冗余，越带即报警（门禁复算包含关系）"
      },
      "maxAbsJump": {
        "statistic": "manual-policy",
        "window": "2025-12-22 ~ 2026-11-20",
        "measured": {
          "maxJump": 0,
          "p998Jump": 0,
          "n": 12
        },
        "note": "声明 0.5 高于实测 99.8 分位 0：有意留宽的保守带，低于该分位即判太紧"
      }
    }
  }
}
